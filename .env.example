# ─── Login com o seu usuário Microsoft (Entra ID) ───────────────
# Usado quando AZDO_AUTH=entra e/ou Azure OpenAI sem API key.
# Pré-requisito: rodar `az login` uma vez (ou usar AZURE_AUTH_INTERACTIVE=true).
# ID do tenant da empresa (recomendado se você tiver mais de um tenant)
AZURE_TENANT_ID=
# true = se não houver sessão do az/Visual Studio/VS Code, abre o navegador para logar
AZURE_AUTH_INTERACTIVE=false

# ─── Azure DevOps ────────────────────────────────────────────────
# pat   = usa AZDO_PAT
# entra = usa o seu login Microsoft (só Azure DevOps Services / dev.azure.com)
AZDO_AUTH=entra
# PAT com escopo "Code (Read)" para revisar e "Code (Read & write)" para postar comentários.
AZDO_PAT=

# ─── Provedor de IA: copilot | azure-openai | anthropic | openai ─
AI_PROVIDER=copilot

# GitHub Copilot CLI (usa o seu login do GitHub; instale com: npm install -g @github/copilot)
# Modelo opcional; sem valor, usa o padrão da sua licença. Veja os disponíveis com /model dentro do `copilot`.
COPILOT_MODEL=
# Tempo máximo por lote de arquivos
COPILOT_TIMEOUT_SECONDS=600
# Caminho do executável, se não estiver no PATH
COPILOT_BIN=

# Azure OpenAI (o código não sai do tenant da empresa)
# Endpoint e nome do deployment: peça ao time que administra o recurso, ou veja no portal do Azure.
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deixe vazio para autenticar com o seu usuário (precisa da função "Cognitive Services OpenAI User")
AZURE_OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: gateway/proxy corporativo compatível com a API da Anthropic
ANTHROPIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# ─── Ajustes da revisão (opcionais) ──────────────────────────────
# Idioma dos comentários
REVIEW_LANGUAGE=português do Brasil
# Tamanho aproximado (em caracteres) de diff enviado por chamada à IA
REVIEW_BATCH_CHARS=60000
# Arquivos com mais linhas que isso são ignorados
REVIEW_MAX_FILE_LINES=3000
# Padrões extras a ignorar, separados por vírgula (glob)
REVIEW_EXTRA_IGNORE=

{
  "name": "ai-pr-review",
  "version": "0.1.0",
  "description": "Revisão de Pull Requests do Azure DevOps com IA (Angular e C#), rodando localmente com o seu PAT.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "review": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
